# Supply-chain hardening. Both settings are npm-native — no extra tooling.
#
# REQUIRES npm >= 11.16.0 (Node >= 24.18). Earlier npm does not recognise
# `strict-allow-scripts`: it emits one `npm warn Unknown project config` line and
# installs with NO protection at all. That is a fail-open, so ci.yml asserts both
# options are recognised rather than trusting the runner's npm.

# Dependency install scripts (preinstall/install/postinstall) are default-DENY.
# npm only runs the ones pinned in the `allowScripts` field of package.json, and
# ANY package that grows a new install script hard-fails the install with
# ESTRICTALLOWSCRIPTS instead of silently executing as your user.
#
# This is the single most common npm attack path (event-stream, ua-parser-js,
# Shai-Hulud): the lockfile's integrity hashes prove you got the bytes the
# publisher published, but prove nothing about the publisher's account not having
# been hijacked. Without this flag npm's allowScripts field is advisory only — it
# prints a warning and runs the script anyway.
#
# When a legitimate dependency bump introduces a new install script, review the
# script, then approve it. `npm approve-scripts` resolves packages from the tree
# ON DISK, so the obvious sequence does NOT work: `npm ci` deletes node_modules
# and this gate aborts before writing it, leaving nothing to match and the
# command failing with ENOMATCH. Populate a tree first:
#
#   npm install --ignore-scripts     # tree on disk, nothing executed
#   npm approve-scripts <pkg>        # writes the pin into package.json
#   npm ci                           # verify, then commit package.json
#
# Never reach for --dangerously-allow-all-scripts. Always re-run `npm ci` at the
# end and trust its error over the command's output: with a stale node_modules,
# approve-scripts can report success while writing a pin for the wrong version.
strict-allow-scripts=true

# Only install package versions that have been public for at least 7 days. Most
# account-takeover compromises are detected and yanked within 24-72h, so a week
# of latency turns the majority of them into something we never install at all.
#
# This gates dependency RESOLUTION only — the moment a NEW version is chosen.
# `npm ci`, and `npm install` against a lockfile that already satisfies every
# range, reuse the locked versions without re-resolving and are unaffected, so
# CI and releases never fail because a pinned version is younger than the window.
# It complements the `cooldown` in .github/dependabot.yml: that one gates the PRs
# Dependabot opens, this one gates any resolution done here — `npm install <pkg>`,
# `npm update`, or a range that no longer matches the lockfile.
#
# SCOPE: this file covers the root workspace only. npm reads .npmrc from the
# nearest package.json dir, so workers/signup and scripts/gcp-focus-exporter —
# which have their own package.json — get NEITHER guard. See CLAUDE.md.
#
# Escape hatch for a genuinely urgent fresh release: `min-release-age-exclude`,
# or a one-off `npm install --min-release-age=0`.
min-release-age=7
