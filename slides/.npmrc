# The root .npmrc's supply-chain guards, repeated: npm reads .npmrc from the
# nearest package.json directory, so the root file does not cover this one.
# The root file and CLAUDE.md ("Dependency supply chain") explain each guard,
# including how to approve a new install script. Requires npm >= 11.16.0.
strict-allow-scripts=true
min-release-age=7
engine-strict=true
