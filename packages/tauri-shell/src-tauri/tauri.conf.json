{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CostGoblin Tauri Spike",
  "version": "0.0.0",
  "identifier": "com.costgoblin.tauri.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5599",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CostGoblin (Tauri spike)",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
